 "layout_notes": [
  "Place the VS and VDD I/O decoupling capacitors close to the ADXL345 supply pins.",
  "Keep the ground connection from the ADXL345 to the power-supply ground low impedance, because noise on ground affects the device similarly to noise on VS.",
  "Use separate supplies for VS and VDD I/O to minimize digital clocking noise on the VS supply; if not possible, add filtering as described.",
  "Mount the device in a location close to a hard mounting point of the PCB to the case; an unsupported PCB location can cause large apparent measurement errors.",
  "Multiple mounting points close to the sensor and/or a thicker PCB help reduce system resonance effects.",
  "Place the 1 µF tantalum at VS and the 0.1 µF ceramic at VDD I/O close to the ADXL345 supply pins.",
  "Connect the ADXL345 ground to the power supply ground with low impedance; ground noise affects the part like noise on VS.",
  "Use separate supplies for VS and VDD I/O to minimize digital clocking noise on VS; if this is not possible, add filtering to the supplies.",
  "Mount the accelerometer close to a hard mounting point to the case; use multiple mounting points near the sensor and/or a thicker PCB to reduce system resonance.",
  "An accelerometer located far from a mounting point can show PCB vibration as apparent measurement error."
 ],
 "extra": {
  "supply_voltage_range": "VS 2.0 V to 3.6 V; tested and specified at 2.5 V (page 33)",
  "test_conditions": "TA = 25°C, VS = 2.5 V, VDD I/O = 1.8 V (page 19)",
  "interface_select": "CS tied to VDD I/O selects I2C mode; CS must be connected to VDD I/O when using I2C (page 18)",
  "alt_address_pin": "tie to VDD I/O for address 0x1D (write 0x3A, read 0x3B) or to GND for address 0x53 (write 0xA6, read 0xA7); no internal pull-up or pull-down, so a floating pin has no defined state (page 18)",
  "i2c_bus_voltage_limit": "other devices on the same I2C bus must not exceed VDD I/O by more than 0.3 V (page 18)",
  "i2c_max_output_data_rate": "800 Hz at 400 kHz I2C; scales linearly with bus speed, e.g. 200 Hz at 100 kHz (page 18)",
  "interrupt_outputs": "INT1 and INT2 are push-pull, active high by default; INT_INVERT bit in DATA_FORMAT makes them active low; no pull-up stated (page 20)",
  "offset_register_scale": "15.6 mg/LSB, independent of g-range; power cycling resets offset registers to 0x00 (page 30)",
  "self_test_conditions": "LOW_POWER bit = 0 in BW_RATE and ODR 100-800 Hz or 3200 Hz; full resolution at ±16 g recommended (page 31)",
  "optional_vs_bypass": "0.1 µF ceramic in parallel with 10 µF tantalum on VS may improve noise (page 28)",
  "CS pin (I2C mode)": "must be tied to VDD I/O (page 18)",
  "ALT ADDRESS pin (I2C mode)": "must be tied to VDD I/O or GND (page 18); VDD I/O gives I2C address 0x1D (write 0x3A, read 0x3B), GND gives 0x53 (write 0xA6, read 0xA7) (page 18)",
  "unused/undriven pins": "CS, SCLK, SDI and SDO have no internal pull-up or pull-down and must be driven for proper operation (page 17); CS and ALT ADDRESS have no known state if left floating (page 18)",
  "I2C bus loading": "other devices on the bus must not exceed VDD I/O by more than 0.3 V; Cb max 400 pF per bus line; fSCL max 400 kHz (pages 18-19)",
  "interrupt pins": "INT1 and INT2 are push-pull, active high by default, switchable to active low with INT_INVERT (page 20)",
  "supply range": "VS specified at 2.5 V, operable from 2.0 V to 3.6 V; offset, sensitivity, noise, self-test and supply current change with VS (page 33)",
  "equations omitted": "Offset and self-test equations on pages 30-31 (XACTUAL, YACTUAL, ZACTUAL, Z0g, XST, YST, ZST) use LSB units, which are outside the allowed unit list, so they are not included"
 },
